# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values below.
# `.env.local` is git-ignored — never commit real keys.
# ---------------------------------------------------------------------------

# Supabase — Project Settings → API in the Supabase dashboard.
# The anon key is public (ships to the browser); the service_role key is secret
# (server-only, used by seed/import scripts and privileged server code).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL — used for SEO metadata, sitemap.xml, OG images and RSS.
# No trailing slash. Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
